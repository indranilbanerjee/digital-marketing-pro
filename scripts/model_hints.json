{
  "$comment": "Hint book for scripts/model_router.py: each job names a provider and a model line (Anthropic) or a family pattern over ids (OpenAI) plus the capabilities it needs, never a model id. The router picks the newest active, generally available model in that line or family, at least 14 days old, from the provider's live list. default_alias names the scripts/model_registry.json alias used offline. 'deprecations' records what an agent read from a provider's deprecations page, for providers whose list reports no lifecycle; re-read it within 30 days. Every rule and record carries the page it was read from and the date.",
  "schema": 1,
  "jobs": {
    "ai-visibility.probe.anthropic": {
      "provider": "anthropic",
      "line": "sonnet",
      "capabilities": [],
      "default_alias": "latest-balanced-anthropic",
      "why": "Asks the model the brand's buyer questions and checks whether the brand is named; a mid-tier line is what most people meet in Claude, and the job needs no special capability.",
      "source": "https://platform.claude.com/docs/en/api/models/list",
      "read_on": "2026-10-27"
    },
    "ai-visibility.probe.openai": {
      "provider": "openai",
      "family": "^gpt-(?P<version>\\d+(?:\\.\\d+)*)-sol$",
      "default_alias": "latest-balanced-openai",
      "why": "Same probe on OpenAI. Sol is the family the models page features as the balanced default (GPT-6.1 Sol on 2026-10-27, GPT-6 Sol and GPT-5.6 Sol before it); the router takes the highest version this key can call.",
      "source": "https://developers.openai.com/api/docs/models",
      "read_on": "2026-10-27"
    }
  },
